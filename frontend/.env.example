# Wise Laundry Frontend Environment Configuration

# API Base URL:
# Leave as '/api/v1' for same-origin routing in staging/production,
# or when using the built-in Vite dev proxy on localhost:5173.
VITE_API_BASE_URL=/api/v1

# Routing mode: set to 'true' only if deploying to static hosts without URL rewriting
VITE_HASH_ROUTER=false

# Google sign-in: OAuth client ID from Google Cloud Console (same value as GOOGLE_CLIENT_ID in backend/.env).
# Leave empty to hide the "Continue with Google" button.
VITE_GOOGLE_CLIENT_ID=

# Help & support page contact buttons. Leave any empty to hide that button.
# WhatsApp: full number with country code, digits only (e.g. 919876543210).
VITE_SUPPORT_WHATSAPP=
VITE_SUPPORT_PHONE=
VITE_SUPPORT_EMAIL=
