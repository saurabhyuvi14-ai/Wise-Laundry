# Server Configuration
PORT=4000
NODE_ENV=development

# MongoDB Atlas Database URI (Placeholder - Replace with your MongoDB Atlas cluster connection string)
# Format: mongodb+srv://<username>:<password>@<cluster-subdomain>.mongodb.net/<database_name>?retryWrites=true&w=majority&appName=<appName>
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/wise_laundry?retryWrites=true&w=majority

# Isolated Test Database URI (Optional override for automated tests; defaults to in-memory MongoDB runner during tests)
MONGODB_TEST_URI=mongodb://127.0.0.1:27017/wise_laundry_test

# Cryptography & Security Keys
# ENCRYPTION_KEY: 32-character or longer high-entropy key for AES-256-GCM field encryption
ENCRYPTION_KEY=wise_laundry_super_secret_encryption_key_32_bytes_min
# SESSION_SECRET: High-entropy secret for hashing session tokens
SESSION_SECRET=wise_laundry_session_secret_change_me_in_production_min_32

# CORS & CSRF Whitelist (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=20

# Pickup Slot Capacity Configuration
DEFAULT_SLOT_CAPACITY=5

# Google sign-in: OAuth client ID from Google Cloud Console (APIs & Services > Credentials).
# Use the same value as VITE_GOOGLE_CLIENT_ID in frontend/.env. Leave empty to switch Google sign-in off.
GOOGLE_CLIENT_ID=

# Location & Reverse-Geocoding Configuration
# GEOCODING_PROVIDER: 'nominatim' (default, free OSM) or 'google' (requires GOOGLE_MAPS_API_KEY)
GEOCODING_PROVIDER=nominatim
GOOGLE_MAPS_API_KEY=
GEOCODING_USER_AGENT=WiseLaundry/1.0 (support@wiselaundry.in)

# Service Area Availability Configuration (Bengaluru default)
SERVICE_AREA_CITIES=Bengaluru,Bangalore
SERVICE_AREA_PINCODE_PREFIXES=560
SERVICE_AREA_CENTER_LAT=12.9716
SERVICE_AREA_CENTER_LNG=77.5946
SERVICE_AREA_RADIUS_KM=35

# Cancel / reschedule rules
# Customers can change an order until this many minutes before the pickup window starts.
ORDER_CHANGE_CUTOFF_MINUTES=120
ORDER_MAX_RESCHEDULES=2
ORDER_RESCHEDULE_MAX_DAYS=7
