# Wise Laundry Backend Environment Variables
NODE_ENV=development
PORT=4000

# MongoDB Configuration (separate databases for local, test and production)
MONGODB_URI=mongodb://127.0.0.1:27017/wise_laundry_dev
MONGODB_TEST_URI=mongodb://127.0.0.1:27017/wise_laundry_test

# Managed Field Encryption Key (32-byte hex or 32+ character secret)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Session Secret (used for token hashing salt)
SESSION_SECRET=wise-laundry-dev-session-secret-change-in-production

# CORS & CSRF Allowed Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=20

# Slot Capacity (maximum pickups per 2-hour window)
DEFAULT_SLOT_CAPACITY=10
